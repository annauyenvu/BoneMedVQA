# BoneMedVQA environment template — copy to .env and fill values
# Never commit real credentials or patient identifiers.

BONEMEDVQA_DEVICE=auto
BONEMEDVQA_DATA_ROOT=./data
BONEMEDVQA_OUTPUT_ROOT=./outputs
BONEMEDVQA_CHECKPOINT=
BONEMEDVQA_CONFIDENCE_THRESHOLD=0.55
BONEMEDVQA_MAX_IMAGE_MB=15
BONEMEDVQA_API_HOST=0.0.0.0
BONEMEDVQA_API_PORT=8000
BONEMEDVQA_LOG_LEVEL=INFO

# Inference backend: auto | openai | blip | local
# auto = OpenAI if OPENAI_API_KEY is set, else BLIP pretrained, else local checkpoint
BONEMEDVQA_BACKEND=auto
BONEMEDVQA_CONFIG=configs/baseline.yaml

# Optional OpenAI Vision (recommended for best demo quality)
# OPENAI_API_KEY=sk-...
# OPENAI_VISION_MODEL=gpt-4o-mini

# Optional Hugging Face cache
# HF_HOME=./.cache/huggingface
# TRANSFORMERS_OFFLINE=0
